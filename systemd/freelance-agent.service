[Unit]
Description=Freelance Agent (AI freelance discovery & proposal assistant)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/freelance-agent
EnvironmentFile=/opt/freelance-agent/.env
ExecStart=/opt/freelance-agent/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
