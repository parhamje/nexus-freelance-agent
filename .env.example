# ===================== Freelance Agent configuration =====================
# Copy to .env and adjust. Every value can also be provided as a real
# environment variable (environment variables win over .env).

# --- Core ---
FREELANCE_DEBUG=false
# CHANGE THIS in production: random 64+ chars, e.g. `openssl rand -hex 32`
FREELANCE_SECRET_KEY=change-me-to-a-long-random-string
# Optional dedicated Fernet key for credential encryption (base64).
# If empty, a key is derived from FREELANCE_SECRET_KEY.
FREELANCE_ENCRYPTION_KEY=

# --- Database (PostgreSQL in production) ---
FREELANCE_DATABASE_URL=postgresql+asyncpg://freelance:freelance@localhost:5432/freelance_agent
# Local development / tests only:
# FREELANCE_DATABASE_URL=sqlite+aiosqlite:///./freelance_agent.db

# --- Redis (optional; enables multi-worker coordination) ---
FREELANCE_REDIS_URL=

# --- Dashboard admin account (created on first start) ---
FREELANCE_ADMIN_USERNAME=admin
FREELANCE_ADMIN_PASSWORD=change-me-please

# --- Security ---
FREELANCE_ACCESS_TOKEN_EXPIRE_MINUTES=1440
FREELANCE_RATE_LIMIT_PER_MINUTE=240

# --- Discovery defaults (overridable in the dashboard) ---
FREELANCE_DEFAULT_SCAN_INTERVAL_MINUTES=20
FREELANCE_TIME_SAVED_PER_PROPOSAL_MINUTES=45

# --- Paths ---
FREELANCE_FRONTEND_DIR=frontend
FREELANCE_LOG_LEVEL=INFO

# --- Telegram webhook mode (optional; polling is default) ---
# Must also be set as the webhook URL in Telegram, ending with this secret.
FREELANCE_TELEGRAM_WEBHOOK_SECRET=
